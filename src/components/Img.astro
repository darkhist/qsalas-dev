---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
}

const { src, alt, priority = false } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  format="webp"
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  widths={[400, 650, 1300]}
  sizes="(max-width: 650px) 100vw, 650px"
/>
